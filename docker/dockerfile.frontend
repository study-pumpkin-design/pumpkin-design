
FROM oven/bun:canary-alpine AS dependencies
WORKDIR /app

COPY package.json bun.lock turbo.json ./
COPY apps/client/package.json ./apps/client/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN bun install --frozen-lockfile


FROM oven/bun:canary-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/client/node_modules ./apps/client/node_modules
COPY --from=dependencies /app/packages/ui/node_modules ./packages/ui/node_modules
COPY package.json bun.lock turbo.json ./
COPY apps/client ./apps/client
COPY packages/ui ./packages/ui
ENV NODE_ENV=production
RUN bunx turbo run build --filter=client...


FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/apps/client/.next/standalone ./
COPY --from=builder /app/apps/client/.next/static ./apps/client/.next/static

EXPOSE 3000
CMD ["node", "apps/client/server.js"]
