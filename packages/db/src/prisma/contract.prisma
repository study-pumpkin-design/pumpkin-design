// use prisma-8

enum RANK {
  BEGINNER
}

enum USER_TYPE {
  GUEST_ACCOUNT
  USER_ACCOUNT
}

enum MODERATOR_TYPE {
  ADMIN
  SUPERADMIN
  CONTENT
}

enum GROUP_ROLE {
  ADMIN
  MODERATOR
  MEMBER
}

model User {
  id           String         @id @onCreate(uuid())
  email        String         @unique
  username     String         @unique
  name         String?
  phone_number String?        @unique
  points       BigInt         @default(0)
  profile_pic  String         @default("")
  headline     String         @default("")
  bio          String         @default("")
  rank         RANK           @default(BEGINNER)
  user_type    USER_TYPE      @default(GUEST_ACCOUNT)
  groupMembers GroupMembers[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @onUpdate(now()) 
}

model Moderator {
  id             String         @id @onCreate(uuid())
  email          String         @unique
  username       String         @unique
  phone_number   String?        @unique
  name           String?
  moderator_type MODERATOR_TYPE @default(CONTENT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @onUpdate(now())
}

model Group {
  id           String         @id @onCreate(uuid())
  name         String
  description  String         @default("")
  group_icon   String         @default("")
  groupMembers GroupMembers[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @onUpdate(now())
}

model GroupMembers {
  id         String     @id @onCreate(uuid())
  group_id   String
  member_id  String
  group_role GROUP_ROLE @default(MEMBER)
  group      Group      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  member     User       @relation(fields: [member_id], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime  @onUpdate(now())
}
